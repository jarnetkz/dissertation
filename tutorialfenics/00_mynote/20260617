    while t < T + 1e-12:
    
        # update BC
        p_right.t = t
    
        # solve pressure
        solve(a == L, p, [bc0, bc2, bc3])
    
        # Darcy velocity
        velocity_expr = conditional(
            le(x[0], l),
            -K_left * grad(p),
            -K_right * grad(p)
        )
    
        velocity.assign(project(velocity_expr, Vvec))
        vel.assign(velocity)
    
        # solve transport
        solve(a_c == L_c, c_sol)
    
        c_n.assign(c_sol)
    
        if t >= next_save - 1e-12:
    
            vtkfile_p << (p, t)
            vtkfile_v << (velocity, t)
            vtkfile_c << (c_sol, t)
    
            print("Saved at t =", t)
    
            next_save += dt_save
    
        t += dt


